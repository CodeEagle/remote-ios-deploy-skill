# Copy to a private path, replace values, then source from a trusted shell.
export PHONE_ADDRESS='REPLACE_PHONE_SERVICE_IP'
export LOCAL_IP='REPLACE_THIS_MAC_LAN_IPV4'
export RP_HOSTNAME='REPLACE_PHONE_HOSTNAME.local'
export RP_INSTANCE='REPLACE_REAL_BONJOUR_UUID'
export RP_AUTHTAG='REPLACE_REAL_AUTH_TAG'
export RP_VER='26'
export RP_MINVER='8'
export RP_FLAGS='0'
export CONTROL_PORT='49152'
export TUNNEL_PORTS='49800-50000,55000-55300'
# Read these TXT fields from the phone; ver is not the marketing iOS version.

# bridge-dynamic.py (iOS 27 tunnel-port drift) reads these instead of TUNNEL_PORTS:
# export PREFETCH='8'        # on each negotiated endpoint P, also relay P+1..P+PREFETCH
# export IDLE_TTL='600'      # reap relays with no connection older than this (seconds)
# export CLEAN_INTERVAL='60' # how often to reap idle relays
